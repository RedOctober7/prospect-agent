# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — secrets never get committed.

# Anthropic — research + opener generation.
# Web search must also be enabled for your org in the Anthropic Console.
ANTHROPIC_API_KEY=

# Supabase Postgres connection strings.
# DATABASE_URL  = pooled connection (port 6543, ?pgbouncer=true) — used at runtime.
# DIRECT_URL    = direct connection (port 5432) — used by `prisma migrate`.
DATABASE_URL=
DIRECT_URL=

# Username + password for the app's sign-in page (gates UI + API routes) —
# set both before any real deploy, or anyone with the URL can burn your
# Anthropic API budget. Leave both empty for local dev to skip sign-in.
# Generate a password locally, don't let an assistant write the value in:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
APP_BASIC_AUTH_USER=
APP_BASIC_AUTH_PASSWORD=

# Secret for the Supabase keep-alive cron (3 runs a day, see vercel.json). Vercel sends
# it as "Authorization: Bearer <CRON_SECRET>"; without it the cron gets a
# 401 and does nothing. Only needed on Vercel (Production). Generate locally:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
